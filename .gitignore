# Build artifacts
build/
build-*/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
Makefile
build.ninja
.ninja_deps
.ninja_log
*.o
*.a
*.so
*.so.*
*.dylib
# Qt meta-object / resource / ui compiler output (AUTOMOC, AUTORCC, AUTOUIC).
# These are regenerated on every build - never publish them.
moc_*
mocs_compilation*
qrc_*
ui_*
*_autogen/
.qt/
**/.qt/
.cache/

# Binaries
AnimoServer
AnimoClient
*.exe

# Runtime data (databases, logs, session history)
data/
*.db
*.db-journal
*.db-wal
*.db-shm
error.log
error.log.*

# Session persistence files (contain encrypted tokens)
*.animosession
*.animosessions

# Engagement output - never commit captured data
loot/

# Runtime state that lands at the repo root depending on the launch dir
saved_sessions.dat
device_certs.dat
history_*.txt

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.project
.cproject
.settings/
*.creator
*.creator.user
*.user
compile_commands.json

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# Core dumps
core
core.*
vgcore.*

# Temporary files
*.tmp
*.bak
*.orig

# Debug log mirrors written by the runtime (see DEBUGGING.md)
animo-*-dbg.log
animo-*-gdb.log
